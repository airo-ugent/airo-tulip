[Unit]
# Installed by install.sh, which substitutes the placeholder tokens at install time.
Description=AIRO-tulip server (KELO Robile drive control)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=1
# Runs as root: the EtherCAT master (pysoem) needs raw-socket access to the network interface.
ExecStart=__SERVER_BIN__ --config __CONFIG__

[Install]
WantedBy=multi-user.target
