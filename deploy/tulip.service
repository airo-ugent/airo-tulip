[Unit]
# Installed by install.sh, which substitutes the placeholder tokens at install time.
Description=AIRO-tulip server (KELO Robile drive control)
After=network.target zenoh.service
Wants=zenoh.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=1
User=__USER__
ExecStart=__SERVER_BIN__ --config __CONFIG__

[Install]
WantedBy=multi-user.target
