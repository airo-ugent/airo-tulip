[Unit]
# Installed by install.sh, which substitutes the placeholder tokens at install time.
Description=Zenoh router (zenohd) for airo-tulip
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=1
ExecStart=__ZENOHD__

[Install]
WantedBy=multi-user.target
