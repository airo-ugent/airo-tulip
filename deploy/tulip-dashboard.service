[Unit]
# Installed by install.sh, which substitutes the placeholder tokens at install time.
Description=AIRO-tulip dashboard server
After=network.target zenoh.service
Wants=zenoh.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=1
User=__USER__
ExecStart=/usr/bin/env bash -c ". __KELORC__ ; __START_DASHBOARD__"

[Install]
WantedBy=multi-user.target
